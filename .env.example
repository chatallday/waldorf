# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TEABLE_API_KEY: Required for Teable API calls
TEABLE_API_KEY="YOUR_TEABLE_API_KEY_HERE"

# STRIPE_API_KEY: Required for Stripe payment processing
# Should be a restricted key with only:
#   - Products: Write
#   - Payment Links: Write
STRIPE_API_KEY="YOUR_STRIPE_API_KEY_HERE"

# STRIPE_SEEKER_PRO_PRICE_ID: Price ID for Seeker Pro subscription ($13.99/month)
STRIPE_SEEKER_PRO_PRICE_ID="price_1YourSeekerProPriceIDHere"

# STRIPE_MENTOR_PRO_PRICE_ID: Price ID for Mentor Pro subscription ($19.99/month)
STRIPE_MENTOR_PRO_PRICE_ID="price_1YourMentorProPriceIDHere"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
